{
  "$schema": "hermes-rewrite-contract/v1",
  "id": "fallback_before_visible_output",
  "kind": "agent_turn",
  "description": "A retryable failure may fall back only before any model output is visible.",
  "evidence": [
    "tests/run_agent/test_provider_fallback.py",
    "run_agent.py"
  ],
  "input": {
    "transport": "chat_completions",
